{
  "name": "nuxt",
  "private": true,
  "contributors": [
    {
      "name": "Robin Vey",
      "url": "https://github.com/robinscholz"
    },
    {
      "name": "Christoph Jeworutzki",
      "url": "https://github.com/ChristophJeworutzki"
    }
  ],
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "nuxt-module-build build --outDir ../../dist/nuxt && nuxi prepare playground",
    "dev": "nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "lint": "eslint .",
    "test": "vitest run",
    "test:prepare": "playwright-core install chromium",
    "test:watch": "vitest watch",
    "typecheck": "nuxi typecheck playground && nuxi typecheck test/fixtures/basic"
  },
  "dependencies": {
    "@nuxt/kit": "^4.6.1",
    "defu": "^6.1.7",
    "ufo": "^1.6.4"
  },
  "peerDependencies": {
    "@nuxt/image": "^2.0.0",
    "@unlazy/nuxt": "^2.0.1"
  },
  "peerDependenciesMeta": {
    "@nuxt/image": {
      "optional": false
    },
    "@unlazy/nuxt": {
      "optional": false
    }
  },
  "devDependencies": {
    "@nuxt/devtools": "latest",
    "@nuxt/image": "^2.1.0",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.6.1",
    "@nuxt/test-utils": "4.0.0",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@types/node": "^25.9.9",
    "@unlazy/nuxt": "^2.0.1",
    "eslint": "^10.12.0",
    "nuxt": "^4.6.1",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.13"
  },
  "version": "1.0.2"
}
