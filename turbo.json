{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "ui": "tui",
  "tasks": {
    "//#t:release": {
      "cache": false,
      "dependsOn": ["nuxt#typecheck", "nuxt#test", "nuxt#build"]
    },
    "test": {},
    "lint": {},
    "typecheck": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "outputs": ["./dist/**"]
    },
    "nuxt#dev": {
      "cache": false,
      "persistent": true
    },
    "nuxt#build": {
      "outputs": ["../../dist/nuxt/**"]
    }
  }
}
